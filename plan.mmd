    end

    %% User → UI
    UDrag --> BrowserDrawer
    UType --> AddressBar
    UNav --> NavControls
    UToggle --> BrowserDrawer
    UKbd --> buildMenu
    UResize --> TE1
    UDPR --> TE2
    UQuit --> runExit

    %% UI internals
    BrowserDrawer --> drawerLayout
    BrowserDrawer --> browserStore
    BrowserDrawer --> PageAreaHost
    AddressBar --> urlScheme
    AddressBar --> browserIpc
    AddressBar --> browserStore
    NavControls --> browserIpc

    %% Hooks
    useBrowserBounds --> TE1
    useBrowserBounds --> TE2
    useBrowserBounds --> PageAreaHost
    useBrowserBounds --> browserIpc
    useBrowserLifecycle --> TCMenu
    useBrowserLifecycle --> TCNav
    useBrowserLifecycle --> browserIpc
    useBrowserLifecycle --> browserStore

    %% Menu chain
    buildMenu --> onMenuEvent
    onMenuEvent --> TCMenu

    %% IPC frontend → Rust
    browserIpc --> BrowserCommands
    browserIpc --> settingsRs

    %% Rust commands → state
    BrowserCommands --> validateBrowserUrl
    BrowserCommands --> BrowserStateOps
    BrowserStateOps --> BrowserSlot
    BrowserStateOps --> BrowserWebviewState
    BrowserStateOps --> CreateGuard
    settingsRs --> AppStateLock
    runExit --> BrowserStateOps

    %% Rust nav-event back-channel
    BrowserCommands -.installs.-> TCNav

