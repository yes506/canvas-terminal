flowchart LR
    subgraph CallSites["call sites (additive option/handle changes)"]
        TM["terminalManager.ts"]
        AMT["AgentMiniTerminal.tsx"]
    end
    subgraph ShadowFile["xtermShadowTextarea.ts (NEW)"]
        ST["ShadowTextarea<br/>mount / repositionToCursor<br/>clearValue / dispose"]
    end
    subgraph ShimFile["xtermImeShim.ts (REWRITTEN)"]
        ISO["ImeShimOrchestrator<br/>attach (==attachKoreanImeShim)<br/>rebind / dispose"]
        CR["CompositionRouter<br/>onCompositionStart<br/>onCompositionUpdate<br/>onCompositionEnd<br/>onTerminatingKey<br/>onBlurDuringComposition"]
        KR["KeyRouter (6 methods)<br/>routePrintable<br/>synthesizeKeydown<br/>routePaste (ClipboardEvent)<br/>routeBeforeInputReplace (autocorrect)<br/>routeCopy / routeCut"]
        OV["CursorOverlay<br/>show / clear<br/>reposition / updateStyle"]
        HTI["HelperTextareaIsolator<br/>installFocusRedirect<br/>mirrorFocusState<br/>restoreNativeFocus"]
    end
    subgraph XtermInternals["xterm.js (listeners untouched)"]
        HT[".xterm-helper-textarea"]
        KD["_keyDown<br/>(Terminal.ts:379)"]
        INPUT_API["terminal.input(data)<br/>(public, CoreTerminal.ts:171)"]
        PASTE_API["terminal.paste(text)<br/>(public, Terminal.ts:890)"]
        FOCUS_LIS["focus/blur listeners<br/>(Terminal.ts:467-468)"]
        TD["coreService.triggerDataEvent"]
        OD["terminal.onData"]
        BUF["buffer.active.cursorX/Y"]
    end
    subgraph BrowserNative["browser/OS native handlers (Branch A + native edit shortcuts)"]
        APP_LAYER["app/window shortcut layer<br/>(Cmd+T, Cmd+W, Cmd+F, etc.)"]
        CLIPBOARD["system clipboard"]
    end
    subgraph Tauri["Tauri IPC"]
        PTY["write_to_pty"]
    end

    TM --> ISO
    AMT --> ISO
    ISO --> ST
    ISO --> CR
    ISO --> KR
    ISO --> OV
    ISO --> HTI

    ST -. "compositionstart/update/end blur during composing" .-> CR
    ST -. "keydown (non-composing)" .-> KR
    ST -. "paste / copy / cut / beforeinput insertReplacementText" .-> KR

    CR --> PTY
    CR --> OV

    KR -. "Branch A: bubble (no synth no preventDefault)" .-> APP_LAYER
    KR -. "Cmd+V/C/X bypass: no synth, no preventDefault on keydown" .-> APP_LAYER
    KR -- "Branch B: printable" --> INPUT_API
    KR -- "Branch C: dispatchEvent(keydown) including Ctrl+letters" --> HT
    KR -. "routePaste (Cmd+V): only preventDefault on shadow event" .-> KR
    HT -. "paste event bubbles from shadow to this.element listener" .-> PASTE_API
    KR -- "routeBeforeInputReplace (autocorrect/dictation): terminal.paste(data)" --> PASTE_API
    KR -- "routeCopy / routeCut: setData (defense-in-depth)" --> CLIPBOARD

    HT --> KD
    KD --> TD
    INPUT_API --> TD
    PASTE_API --> TD
    TD --> OD
    OD --> PTY

    HTI -- "patches focus()" --> HT
    HTI -. "FocusEvent('focus'/'blur')" .-> FOCUS_LIS

    OV -- "reads" --> BUF
